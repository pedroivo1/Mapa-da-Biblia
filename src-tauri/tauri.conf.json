{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mapa da Bíblia",
  "version": "0.1.0",
  "identifier": "org.mscpai.mapadabiblia",
  "build": {
    "frontendDist": "./dist",
    "beforeDevCommand": "node scripts/preparar-tauri.mjs",
    "beforeBuildCommand": "node scripts/preparar-tauri.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Mapa da Bíblia",
        "url": "http://localhost:8000/biblia/",
        "width": 1280,
        "height": 800
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
